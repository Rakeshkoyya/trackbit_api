# Copy to .env and adjust. Never commit real secrets.
#
# Two roles by design:
#   DATABASE_URL       -> restricted app role (NO BYPASSRLS) so RLS applies at runtime
#   ADMIN_DATABASE_URL -> privileged owner role for migrations (DDL + RLS setup)
DATABASE_URL=postgresql+psycopg2://trackbit_app:CHANGE_ME@host:5432/trackbit_db?sslmode=require
ADMIN_DATABASE_URL=postgresql+psycopg2://admin:CHANGE_ME@host:5432/trackbit_db?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg2://trackbit_app:CHANGE_ME@host:5432/trackbit_db?sslmode=require
JWT_SECRET_KEY=dev-secret-change-in-production
DEBUG=true
ENABLE_SCHEDULER=false
FRONTEND_BASE_URL=http://localhost:3000
RATE_LIMIT_ENABLED=true
